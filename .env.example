# API Server Configuration
APP_NAME=api
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info
OPENPR_API_PORT=8081

# Object Storage
# Object storage backs uploads, thumbnails, import files, and protected
# attachment package job artifacts. Defaults to local filesystem storage under
# UPLOAD_DIR or ./uploads. Use s3-compatible for S3/MinIO-style path-based
# object storage.
# OPENPR_OBJECT_STORAGE_BACKEND=local
# OPENPR_OBJECT_STORAGE_DIR=./uploads
# OPENPR_OBJECT_STORAGE_BACKEND=s3-compatible
# OPENPR_OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
# OPENPR_OBJECT_STORAGE_S3_BUCKET=openpr-uploads
# OPENPR_OBJECT_STORAGE_S3_REGION=us-east-1
# OPENPR_OBJECT_STORAGE_S3_ACCESS_KEY_ID=replace_with_access_key
# OPENPR_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=replace_with_secret_key
# OPENPR_OBJECT_STORAGE_S3_SESSION_TOKEN=replace_with_optional_session_token

# Database Configuration
DATABASE_URL=postgres://openpr:replace_with_postgres_password@localhost:5432/openpr
POSTGRES_DB=openpr
POSTGRES_USER=openpr
# Required in production. Use the same value in DATABASE_URL.
# POSTGRES_PASSWORD=replace_with_postgres_password

# JWT Authentication
# Required in production. Generate a long random value for each deployment.
# JWT_SECRET=replace_with_long_random_secret
JWT_ACCESS_TTL_SECONDS=2592000
JWT_REFRESH_TTL_SECONDS=604800

# Docker Compose Overrides
# Uncomment to override default values
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=openpr
# PGUSER=openpr
# PGPASSWORD=openpr_dev_password

# Frontend API Endpoint
# For local frontend development, point the browser at the compose/API host port.
# The production frontend image uses nginx same-origin API proxying.
# Host interface for compose-published API, MCP, frontend, and optional webhook ports.
# Defaults to 127.0.0.1 when unset. Use 0.0.0.0 only for trusted local network testing.
# OPENPR_BIND_HOST=127.0.0.1
VITE_API_BASE_URL=http://localhost:8081
OPENPR_FRONTEND_PORT=3000

# MCP Server Configuration
MCP_SERVER_PORT=8090
OPENPR_API_URL=http://api:8080
# Required when running the MCP server. Generate these for the target workspace.
# OPENPR_BOT_TOKEN=opr_replace_with_workspace_bot_token
# OPENPR_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# DEFAULT_AUTHOR_ID=00000000-0000-0000-0000-000000000000
# Inbound authentication for the MCP HTTP surfaces. When set, /mcp/rpc, /sse and /messages
# require `Authorization: Bearer <token>`; /health stays open for healthchecks. The MCP server
# refuses to start when it binds a non-loopback address (compose binds 0.0.0.0:8090 inside the
# container) and this value is unset, so it is required for `docker compose up`.
# Minimum length 16 characters. Generate with: openssl rand -hex 32
# scripts/start.sh generates one into .env on first run, so a local stack needs no manual setup.
# OPENPR_MCP_AUTH_TOKEN=replace_with_mcp_auth_token

# Outbound Delivery Targets (api + worker)
# Connector and webhook endpoints are validated before every delivery: an endpoint whose host
# resolves to a loopback, private, link-local or otherwise internal address is refused. Hosts that
# must stay reachable (in particular the compose services on the 172.x bridge network) have to be
# listed here as `host` or `host:port`, comma separated. The compose file already defaults to the
# in-cluster services, set this only to add your own internal receivers.
# OPENPR_OUTBOUND_ALLOWED_HOSTS=webhook:9090,api:8080,mcp-server:8090,frontend:80
# Disables the private address checks entirely. Only for a fully trusted network.
# OPENPR_OUTBOUND_ALLOW_PRIVATE=0

# Connector Credentials
# A connector `auth_policy` never stores a raw secret, it references an environment variable as
# `{"mode":"bearer","token_ref":"env:OPENPR_CONNECTOR_SECRET_W_<WORKSPACE>_MYHOOK"}`.
#
# The name is scoped to one workspace. <WORKSPACE> is the workspace UUID with the dashes removed
# and uppercased, for example workspace 0f8a1b2c-3d4e-5f60-7182-93a4b5c6d7e8 owns
# OPENPR_CONNECTOR_SECRET_W_0F8A1B2C3D4E5F60718293A4B5C6D7E8_*. A connector may only reference
# names inside the namespace of the workspace that owns it. Anyone can create a workspace and is
# its admin, so a shared namespace would let a new tenant point a connector at their own server,
# reference someone else's credential and have the delivery signed with it. The workspace id is
# server generated and immutable, so no attacker controlled workspace can reach into another one.
#
# The prefix rules still apply on top: a connector can never be pointed at JWT_SECRET,
# DATABASE_URL, POSTGRES_*, AWS_* or OPENPR_OBJECT_STORAGE_*. Every referenced variable must be
# present in the api and worker environment (add it to docker-compose.yml for container runs).
#
# Upgrading from a release that used the unscoped OPENPR_CONNECTOR_SECRET_<NAME> form: rename each
# variable to the namespace of the workspace whose connectors use it and update the connector
# `auth_policy` references. An unscoped reference is refused at connector save time and, if it was
# already stored, at delivery time; the delivery is failed rather than sent unsigned.
# OPENPR_CONNECTOR_SECRET_W_00000000000000000000000000000000_DEFAULT=replace_with_connector_secret

# Optional webhook connector receiver profile
# OPENPR_WEBHOOK_IMAGE=ghcr.io/openprx/openpr-webhook:latest
# OPENPR_WEBHOOK_CONFIG=./config/openpr-webhook.example.toml
# OPENPR_WEBHOOK_PORT=9090

# Runtime base image used by Dockerfile.prebuilt. The binaries are compiled on the
# host, so this image must ship a glibc at least as new as the host's.
# scripts/start.sh fills this in automatically on Debian hosts.
OPENPR_RUNTIME_BASE=debian:bookworm-slim
