# Build artifacts
/target
/node_modules
/frontend/build
/frontend/.svelte-kit
/frontend/node_modules

# Environment & secrets
.env
.env.*
!.env.example
/frontend/.env
!/frontend/.env.example

# Logs (project-level and frontend dev logs)
*.log
/log/
/frontend/log/
/playwright-report/
/test-results/

# User uploads (runtime data)
/uploads/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Internal dev tools & notes (not for open source)
/.dispatch_link
/AGENTS.md
/PHASE4_EXECUTION_SUMMARY.txt
/PHASE5_SUMMARY.txt
/docs/prd/

# Test scripts (internal)
/test-mcp-server.sh

# Package manager locks (users generate their own)
/frontend/bun.lock

# Database files
*.db
*.sqlite
/CHANGELOG.md
.brv/

# Generated runtime configuration; contains the signing key, the database password and the MCP bot
# token. Both brands are listed: scripts/start.sh writes the canonical `sylvode.*` names, while the
# legacy `openpr.*` names are still discovered when no canonical file exists, so a repository that
# ignores only one of them leaks the other.
/config/openpr.compose*.toml
/config/openpr.toml
/config/sylvode.compose*.toml
/config/sylvode.toml

# Claude Code session state, including agent worktrees that are git repos of their own
.claude/

# Python bytecode caches: regenerated on every run, never a build input.
__pycache__/
*.py[cod]

# Local deployment descriptor: carries a gate account password and machine paths
deploy/flow-deployed-websocket.json

# Local release-gate evidence; authoritative contracts live in the separate read-only checkout.
/.flow-gate/
