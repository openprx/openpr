# syntax=docker/dockerfile:1.7
# Serves a frontend that was already built elsewhere, mirroring the backend's
# Dockerfile.prebuilt. Run `bun run build` first: this image copies ./build and
# never installs a toolchain, so a deployment host needs neither bun nor node.
FROM nginx:alpine
WORKDIR /usr/share/nginx/html

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY build .

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
