{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpr.dev/schemas/sylvode-flow-surface-coverage-result-v1.schema.json",
  "title": "Sylvode Flow Surface Coverage Result v1",
  "description": "Machine-readable REST/MCP/CLI/UI parity result emitted by scripts/verify-flow-surface-coverage.sh, shared v0.4-v1.0. Contract: /opt/working/sylvode-flow/gates/gate-commands.md \"Surface coverage verifier\" section.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "source_head",
    "generated_at",
    "contracts",
    "counts",
    "implementation_parity",
    "violations",
    "passed"
  ],
  "properties": {
    "schema_version": { "const": "sylvode.flow.surface-coverage-result.v1" },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "source_head": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rest_sha256", "mcp_sha256", "cli_sha256", "ui_sha256", "matrix_sha256"],
      "properties": {
        "rest_sha256": { "$ref": "#/$defs/sha256" },
        "mcp_sha256": { "$ref": "#/$defs/sha256" },
        "cli_sha256": { "$ref": "#/$defs/sha256" },
        "ui_sha256": { "$ref": "#/$defs/sha256" },
        "matrix_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rest_total", "rest_in_release", "matrix_rows",
        "mcp_tools_total", "mcp_resources_total", "cli_commands_total",
        "not_exposed"
      ],
      "properties": {
        "rest_total": { "type": "integer", "minimum": 0 },
        "rest_in_release": { "type": "integer", "minimum": 0 },
        "matrix_rows": { "type": "integer", "minimum": 0 },
        "mcp_tools_total": { "type": "integer", "minimum": 0 },
        "mcp_resources_total": { "type": "integer", "minimum": 0 },
        "cli_commands_total": { "type": "integer", "minimum": 0 },
        "not_exposed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mcp", "cli", "ui"],
          "properties": {
            "mcp": { "type": "integer", "minimum": 0 },
            "cli": { "type": "integer", "minimum": 0 },
            "ui": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "implementation_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope", "mcp", "rest", "cli", "version_scope_diagnostic",
        "proof_limitations", "conditional_surface_observation",
        "empty_contract_required_surfaces", "passed"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "rule", "future_entry_disposition", "conditional_entry_disposition"],
          "properties": {
            "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
            "rule": { "type": "string", "minLength": 1 },
            "future_entry_disposition": { "const": "not_yet_in_release entries are diagnostic and never counted as missing" },
            "conditional_entry_disposition": { "type": "string", "minLength": 1 }
          }
        },
        "mcp": { "$ref": "#/$defs/implementation_dimension" },
        "rest": { "$ref": "#/$defs/implementation_dimension" },
        "cli": { "$ref": "#/$defs/implementation_dimension" },
        "version_scope_diagnostic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code", "classification", "message", "release",
            "not_yet_in_release_counts", "future_absent_but_non_failing_counts"
          ],
          "properties": {
            "code": { "const": "future_contract_entries_excluded_from_current_release_failure" },
            "classification": { "const": "verifier_criterion_version_scope" },
            "message": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
            "not_yet_in_release_counts": { "$ref": "#/$defs/implementation_dimension_counts_by_surface" },
            "future_absent_but_non_failing_counts": { "$ref": "#/$defs/implementation_dimension_counts_by_surface" }
          }
        },
        "proof_limitations": { "$ref": "#/$defs/proof_limitations" },
        "conditional_surface_observation": { "$ref": "#/$defs/conditional_surface_observation" },
        "empty_contract_required_surfaces": {
          "type": "array",
          "items": { "enum": ["mcp", "rest", "cli"] },
          "uniqueItems": true,
          "maxItems": 0
        },
        "passed": { "type": "boolean" }
      }
    },
    "violations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_rest_rows", "duplicate_rest_rows", "unknown_matrix_rest_rows",
        "orphan_mcp_tools", "orphan_mcp_resources", "orphan_cli_commands",
        "unknown_mcp_refs", "unknown_cli_refs", "unknown_ui_consumers",
        "blank_cells", "invalid_reason_codes", "reason_column_mismatches",
        "mcp_exception_endpoint_mismatches", "mcp_exception_without_authority",
        "version_inversions", "future_exposure_counted_as_shipped",
        "empty_contract_required_surfaces",
        "contract_mcp_missing_live", "contract_rest_missing_implementation",
        "contract_cli_missing_implementation"
      ],
      "properties": {
        "missing_rest_rows": { "type": "array", "items": { "type": "string" } },
        "duplicate_rest_rows": { "type": "array", "items": { "type": "string" } },
        "unknown_matrix_rest_rows": { "type": "array", "items": { "type": "string" } },
        "orphan_mcp_tools": { "type": "array", "items": { "type": "string" } },
        "orphan_mcp_resources": { "type": "array", "items": { "type": "string" } },
        "orphan_cli_commands": { "type": "array", "items": { "type": "string" } },
        "unknown_mcp_refs": { "type": "array", "items": { "type": "string" } },
        "unknown_cli_refs": { "type": "array", "items": { "type": "string" } },
        "unknown_ui_consumers": { "type": "array", "items": { "type": "string" } },
        "blank_cells": { "type": "array", "items": { "type": "string" } },
        "invalid_reason_codes": { "type": "array", "items": { "type": "string" } },
        "reason_column_mismatches": { "type": "array", "items": { "type": "string" } },
        "mcp_exception_endpoint_mismatches": { "type": "array", "items": { "type": "string" } },
        "mcp_exception_without_authority": { "type": "array", "items": { "type": "string" } },
        "version_inversions": { "type": "array", "items": { "type": "string" } },
        "future_exposure_counted_as_shipped": { "type": "array", "items": { "type": "string" } },
        "empty_contract_required_surfaces": {
          "type": "array",
          "items": { "enum": ["mcp", "rest", "cli"] },
          "uniqueItems": true
        },
        "contract_mcp_missing_live": { "type": "array", "items": { "type": "string" } },
        "contract_rest_missing_implementation": { "type": "array", "items": { "type": "string" } },
        "contract_cli_missing_implementation": { "type": "array", "items": { "type": "string" } }
      }
    },
    "passed": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "implementation_dimension_counts_by_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp", "rest", "cli"],
      "properties": {
        "mcp": { "type": "integer", "minimum": 0 },
        "rest": { "type": "integer", "minimum": 0 },
        "cli": { "type": "integer", "minimum": 0 }
      }
    },
    "release_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_present"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "implementation_present": { "type": "boolean" }
      }
    },
    "conditional_release_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_present", "reason"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "implementation_present": { "type": "boolean" },
        "reason": { "const": "conditional_surface_requires_activation" }
      }
    },
    "proof_limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_kind", "proves", "does_not_prove"],
      "properties": {
        "proof_kind": { "type": "string", "minLength": 1 },
        "proves": { "type": "string", "minLength": 1 },
        "does_not_prove": { "type": "string", "minLength": 1 }
      }
    },
    "proof_limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rest", "cli", "release_scope"],
      "properties": {
        "rest": { "$ref": "#/$defs/proof_limitation" },
        "cli": { "$ref": "#/$defs/proof_limitation" },
        "release_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_entries_compared", "contract_entries_declared", "ratio",
            "excluded_entries", "excluded_disposition"
          ],
          "properties": {
            "required_entries_compared": { "type": "integer", "minimum": 3 },
            "contract_entries_declared": { "type": "integer", "minimum": 3 },
            "ratio": { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" },
            "excluded_entries": { "type": "integer", "minimum": 0 },
            "excluded_disposition": { "const": "not_yet_in_release or conditional_not_applicable" }
          }
        }
      }
    },
    "conditional_surface_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "non_failing", "reason", "mcp_present", "mcp_absent",
        "rest_present", "rest_absent", "cli_present", "cli_absent"
      ],
      "properties": {
        "code": { "const": "conditional_legacy_pages_surface_asymmetry" },
        "non_failing": { "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "mcp_present": { "$ref": "#/$defs/unique_strings" },
        "mcp_absent": { "$ref": "#/$defs/unique_strings" },
        "rest_present": { "$ref": "#/$defs/unique_strings" },
        "rest_absent": { "$ref": "#/$defs/unique_strings" },
        "cli_present": { "$ref": "#/$defs/unique_strings" },
        "cli_absent": { "$ref": "#/$defs/unique_strings" }
      }
    },
    "unique_strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "implementation_dimension": {
      "type": "object",
      "required": [
        "proof", "contract_declared", "contract_required", "required_set_non_empty", "not_yet_in_release",
        "conditional_not_applicable", "implementation",
        "contract_missing_in_implementation", "not_in_flow_contract", "counts", "passed"
      ],
      "properties": {
        "proof": { "type": "string" },
        "contract_declared": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "contract_required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "minItems": 1 },
        "required_set_non_empty": { "const": true },
        "not_yet_in_release": { "type": "array", "items": { "$ref": "#/$defs/release_entry" } },
        "conditional_not_applicable": { "type": "array", "items": { "$ref": "#/$defs/conditional_release_entry" } },
        "implementation": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "contract_missing_in_implementation": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "not_in_flow_contract": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_declared", "contract_required", "not_yet_in_release",
            "not_yet_in_release_absent", "conditional_not_applicable", "implementation",
            "contract_missing_in_implementation", "not_in_flow_contract"
          ],
          "properties": {
            "contract_declared": { "type": "integer", "minimum": 0 },
            "contract_required": { "type": "integer", "minimum": 1 },
            "not_yet_in_release": { "type": "integer", "minimum": 0 },
            "not_yet_in_release_absent": { "type": "integer", "minimum": 0 },
            "conditional_not_applicable": { "type": "integer", "minimum": 0 },
            "implementation": { "type": "integer", "minimum": 0 },
            "contract_missing_in_implementation": { "type": "integer", "minimum": 0 },
            "not_in_flow_contract": { "type": "integer", "minimum": 0 }
          }
        },
        "passed": { "type": "boolean" }
      }
    }
  }
}
