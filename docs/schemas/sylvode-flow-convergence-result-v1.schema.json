{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpr.dev/schemas/sylvode-flow-convergence-result-v1.schema.json",
  "title": "Sylvode Flow v0.3 Convergence Result v1",
  "description": "Dual-candidate convergence corpus evidence emitted by scripts/verify-flow-convergence-v0.3.sh and verified for the v0.3 rust_wasm_roundtrip, rebuild, tree, replay, frame-rejection, limit, and isolated-apply gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_path", "release", "source_head", "generated_at", "candidates"],
  "properties": {
    "schema_version": {
      "const": "sylvode.flow.convergence-result.v1"
    },
    "schema_path": {
      "const": "docs/schemas/sylvode-flow-convergence-result-v1.schema.json"
    },
    "release": {
      "const": "0.3.0"
    },
    "source_head": {
      "$ref": "#/$defs/git_sha"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loro", "yrs-yjs"],
      "properties": {
        "loro": {
          "allOf": [
            { "$ref": "#/$defs/candidate_result" },
            { "properties": { "candidate": { "const": "loro" } } }
          ]
        },
        "yrs-yjs": {
          "allOf": [
            { "$ref": "#/$defs/candidate_result" },
            { "properties": { "candidate": { "const": "yrs-yjs" } } }
          ]
        }
      }
    }
  },
  "$defs": {
    "candidate_name": {
      "enum": ["loro", "yrs-yjs"]
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "isolation_kind": {
      "enum": ["terminable_instance", "worker_sandbox", "async_timeout"]
    },
    "isolation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adversarial_cases_run", "partial_state_unchanged", "status"],
      "properties": {
        "kind": { "$ref": "#/$defs/isolation_kind" },
        "adversarial_cases_run": { "type": "integer", "minimum": 1 },
        "partial_state_unchanged": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "hard_gate_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolated_apply_not_async_timeout",
        "rust_wasm_roundtrip",
        "snapshot_tail_rebuild_hash",
        "concurrent_tree_move_invariants",
        "offline_replay_no_accepted_loss",
        "unauthorized_update_rejected",
        "corrupt_duplicate_out_of_order_limits"
      ],
      "properties": {
        "isolated_apply_not_async_timeout": { "$ref": "#/$defs/status" },
        "rust_wasm_roundtrip": { "$ref": "#/$defs/status" },
        "snapshot_tail_rebuild_hash": { "$ref": "#/$defs/status" },
        "concurrent_tree_move_invariants": { "$ref": "#/$defs/status" },
        "offline_replay_no_accepted_loss": { "$ref": "#/$defs/status" },
        "unauthorized_update_rejected": { "$ref": "#/$defs/status" },
        "corrupt_duplicate_out_of_order_limits": { "$ref": "#/$defs/status" }
      }
    },
    "fixture_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_text_range_edit",
        "concurrent_block_move",
        "ancestor_delete_descendant_move",
        "concurrent_reorder",
        "same_key_nested_container_creation",
        "duplicate_out_of_order_partial_batch",
        "offline_reconnect",
        "snapshot_tail_restore",
        "snapshot_boundary_update",
        "adversarial_update_limits",
        "unicode_ime",
        "local_undo_remote_update",
        "cursor_target_move_delete",
        "policy_rejected_intent_recovery"
      ],
      "properties": {
        "same_text_range_edit": { "$ref": "#/$defs/status" },
        "concurrent_block_move": { "$ref": "#/$defs/status" },
        "ancestor_delete_descendant_move": { "$ref": "#/$defs/status" },
        "concurrent_reorder": { "$ref": "#/$defs/status" },
        "same_key_nested_container_creation": { "$ref": "#/$defs/status" },
        "duplicate_out_of_order_partial_batch": { "$ref": "#/$defs/status" },
        "offline_reconnect": { "$ref": "#/$defs/status" },
        "snapshot_tail_restore": { "$ref": "#/$defs/status" },
        "snapshot_boundary_update": { "$ref": "#/$defs/status" },
        "adversarial_update_limits": { "$ref": "#/$defs/status" },
        "unicode_ime": { "$ref": "#/$defs/status" },
        "local_undo_remote_update": { "$ref": "#/$defs/status" },
        "cursor_target_move_delete": { "$ref": "#/$defs/status" },
        "policy_rejected_intent_recovery": { "$ref": "#/$defs/status" }
      }
    },
    "limit_kind": {
      "enum": [
        "update_bytes",
        "websocket_frame_bytes",
        "tree_depth",
        "container_count",
        "document_block_count",
        "text_block_chars",
        "document_text_chars",
        "semantic_patch_operations"
      ]
    },
    "state_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_before", "head_after", "frontier_before", "frontier_after"],
      "properties": {
        "head_before": { "$ref": "#/$defs/sha256" },
        "head_after": { "$ref": "#/$defs/sha256" },
        "frontier_before": { "$ref": "#/$defs/sha256" },
        "frontier_after": { "$ref": "#/$defs/sha256" }
      }
    },
    "accepted_boundary_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_value", "expected_outcome", "observed_outcome", "operation_log", "final_semantic_json", "semantic_hash", "status"],
      "properties": {
        "observed_value": { "type": "integer", "minimum": 0 },
        "expected_outcome": { "const": "accepted" },
        "observed_outcome": { "enum": ["accepted", "rejected", "cancelled"] },
        "operation_log": { "$ref": "#/$defs/artifact" },
        "final_semantic_json": { "$ref": "#/$defs/artifact" },
        "semantic_hash": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "rejected_boundary_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_value", "expected_outcome", "observed_outcome", "error_limit_kind", "operation_log", "state_hashes", "status"],
      "properties": {
        "observed_value": { "type": "integer", "minimum": 1 },
        "expected_outcome": { "const": "rejected" },
        "observed_outcome": { "enum": ["accepted", "rejected", "cancelled"] },
        "error_limit_kind": {
          "anyOf": [
            { "$ref": "#/$defs/limit_kind" },
            { "type": "null" }
          ]
        },
        "operation_log": { "$ref": "#/$defs/artifact" },
        "state_hashes": { "$ref": "#/$defs/state_hashes" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "boundary_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit_kind", "limit_value", "exact", "boundary_plus_one"],
      "properties": {
        "limit_kind": { "$ref": "#/$defs/limit_kind" },
        "limit_value": { "type": "integer", "minimum": 1 },
        "exact": { "$ref": "#/$defs/accepted_boundary_fixture" },
        "boundary_plus_one": { "$ref": "#/$defs/rejected_boundary_fixture" }
      }
    },
    "boundary_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_bytes",
        "websocket_frame_bytes",
        "tree_depth",
        "container_count",
        "document_block_count",
        "text_block_chars",
        "document_text_chars",
        "semantic_patch_operations"
      ],
      "properties": {
        "update_bytes": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "update_bytes" }, "limit_value": { "const": 65536 } } }] },
        "websocket_frame_bytes": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "websocket_frame_bytes" }, "limit_value": { "const": 131072 } } }] },
        "tree_depth": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "tree_depth" }, "limit_value": { "const": 32 } } }] },
        "container_count": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "container_count" }, "limit_value": { "const": 10000 } } }] },
        "document_block_count": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "document_block_count" }, "limit_value": { "const": 10000 } } }] },
        "text_block_chars": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "text_block_chars" }, "limit_value": { "const": 100000 } } }] },
        "document_text_chars": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "document_text_chars" }, "limit_value": { "const": 1000000 } } }] },
        "semantic_patch_operations": { "allOf": [{ "$ref": "#/$defs/boundary_pair" }, { "properties": { "limit_kind": { "const": "semantic_patch_operations" }, "limit_value": { "const": 100 } } }] }
      }
    },
    "case_category": {
      "enum": [
        "same_text_range_edit",
        "concurrent_block_move",
        "ancestor_delete_descendant_move",
        "concurrent_reorder",
        "same_key_nested_container_creation",
        "duplicate_out_of_order_partial_batch",
        "offline_reconnect",
        "snapshot_tail_restore",
        "snapshot_boundary_update",
        "adversarial_update_limits",
        "unicode_ime",
        "local_undo_remote_update",
        "cursor_target_move_delete",
        "policy_rejected_intent_recovery"
      ]
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "seed", "status", "operation_log", "final_semantic_json", "semantic_hash", "binary_sizes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/case_category" },
        "seed": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "operation_log": { "$ref": "#/$defs/artifact" },
        "final_semantic_json": { "$ref": "#/$defs/artifact" },
        "semantic_hash": { "$ref": "#/$defs/sha256" },
        "binary_sizes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["update_bytes", "snapshot_bytes"],
          "properties": {
            "update_bytes": { "type": "integer", "minimum": 0 },
            "snapshot_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "failure_minimal_reproduction": { "$ref": "#/$defs/artifact" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "required": ["failure_minimal_reproduction"] }
        }
      ]
    },
    "candidate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "corpus_seed",
        "case_count",
        "budget_hash",
        "isolation",
        "hard_gates",
        "fixture_coverage",
        "boundary_results",
        "cases"
      ],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidate_name" },
        "corpus_seed": { "type": "string", "minLength": 1 },
        "case_count": { "type": "integer", "minimum": 1 },
        "budget_hash": { "$ref": "#/$defs/sha256" },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rust", "web"],
          "properties": {
            "rust": { "$ref": "#/$defs/isolation_result" },
            "web": { "$ref": "#/$defs/isolation_result" }
          }
        },
        "hard_gates": { "$ref": "#/$defs/hard_gate_results" },
        "fixture_coverage": { "$ref": "#/$defs/fixture_coverage" },
        "boundary_results": { "$ref": "#/$defs/boundary_results" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/case_result" }
        }
      }
    }
  }
}
