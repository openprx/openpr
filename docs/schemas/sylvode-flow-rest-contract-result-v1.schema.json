{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpr.dev/schemas/sylvode-flow-rest-contract-result-v1.schema.json",
  "title": "Sylvode Flow v0.4 REST contract verifier result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "source_head",
    "generated_at",
    "fixture",
    "endpoint_checks",
    "cross_surface_projection",
    "pagination",
    "bootstrap_limits",
    "violations",
    "passed",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": "sylvode.flow.rest-contract-result.v1" },
    "release": { "const": "0.4" },
    "source_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "fixture": {
      "type": "object",
      "required": ["workspace_id", "object_id", "document_id", "write_event_id", "write_seq"],
      "properties": {
        "workspace_id": { "type": "string", "format": "uuid" },
        "object_id": { "type": "string", "format": "uuid" },
        "document_id": { "type": "string", "format": "uuid" },
        "write_event_id": { "type": "string", "format": "uuid" },
        "write_seq": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "endpoint_checks": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "method", "path", "http_status", "code", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "POST", "PUT"] },
          "path": { "type": "string", "pattern": "^/api/v1/" },
          "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "code": { "type": "integer" },
          "passed": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "cross_surface_projection": { "type": "object" },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "history", "relations"],
      "properties": {
        "list": { "$ref": "#/$defs/v0_4_pagination_check" },
        "history": { "$ref": "#/$defs/v0_4_pagination_check" },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason_code",
            "required_by_gate_release",
            "evaluated_gate_release",
            "probed_http_status",
            "version_boundary_preserved"
          ],
          "properties": {
            "status": { "const": "not_applicable" },
            "reason_code": { "const": "not_applicable_until_v0_5" },
            "required_by_gate_release": { "const": "0.5" },
            "evaluated_gate_release": { "const": "0.4" },
            "probed_http_status": { "const": 404 },
            "version_boundary_preserved": { "const": true }
          }
        }
      }
    },
    "bootstrap_limits": { "type": "object" },
    "violations": { "type": "array", "items": { "type": "string" } },
    "passed": { "type": "boolean" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rest_mcp_cli_ui_surface_parity", "rest_envelope_and_error_contract"],
      "properties": {
        "rest_mcp_cli_ui_surface_parity": { "$ref": "#/$defs/gate" },
        "rest_envelope_and_error_contract": { "$ref": "#/$defs/gate" }
      }
    }
  },
  "$defs": {
    "v0_4_pagination_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_count", "max_100_count", "limit_101_rejected"],
      "properties": {
        "default_count": { "const": 50 },
        "max_100_count": { "const": 100 },
        "limit_101_rejected": { "const": true }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
